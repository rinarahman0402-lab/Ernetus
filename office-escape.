<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Office Escape</title>
<style>
    * { margin: 0; padding: 0; touch-action: none; }
  body { background: #444; display: flex; justify-content: center; align-items: center; height: 100vh; font-family: Arial; }
  #game { position: relative; background: #dcdcdc; border: 6px solid #333; }
  canvas { display: block; background: #e8e8e8; }
  #ui { position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,0.7); color: white; padding: 10px; border-radius: 8px; font-size: 18px; }
  #msg { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.9); color: #ffff00; padding: 30px; font-size: 32px; text-align: center; display: none; border-radius: 15px; }
.btn { position: absolute; bottom: 20px; width: 60px; height: 60px; background: rgba(0,0,0,0.5); border: 2px solid white; border-radius: 12px; color: white; font-size: 24px; display: flex; align-items: center; justify-content: center; }
  #btn-up { left: 80px; bottom: 90px; }
  #btn-down { left: 80px; }
  #btn-left { left: 10px; }
  #btn-right { left: 150px; }
  @media (min-width: 768px) {.btn { display: none; } }
</style>
</head>
<body>

<div id="game">
  <canvas id="canvas" width="800" height="600"></canvas>
  <div id="ui">Snacks: <span id="snacks">0/3</span> | Boredom: <span id="boredom">0%</span></div>
  <div id="msg"></div>

  <div class="btn" id="btn-up">↑</div>
  <div class="btn" id="btn-down">↓</div>
  <div class="btn" id="btn-left">←</div>
  <div class="btn" id="btn-right">→</div>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
let keys = {};
let snacks = 0;
let boredom = 0;
let gameOver = false;

const player = { x: 50, y: 300, w: 25, h: 25, speed: 3 };
const boss = { x: 400, y: 300, w: 30, h: 30, speed: 1.5, dir: 1 };
const exit = { x: 750, y: 280, w: 40, h: 40 };

const snackItems = [
  {x: 200, y: 100, taken: false},
  {x: 600, y: 500, taken: false},
  {x: 350, y: 250, taken: false}
];

const desks = [
  {x: 150, y: 80, w: 100, h: 20}, {x: 300, y: 80, w: 100, h: 20},
  {x: 150, y: 500, w: 100, h: 20}, {x: 300, y: 500, w: 100, h: 20},
  {x: 500, y: 200, w: 20, h: 200}
];

// CONTROLS
document.addEventListener('keydown', e => keys[e.key] = true);
document.addEventListener('keyup', e => keys[e.key] = false);

function addTouch(id, key) {
  const btn = document.getElementById(id);
  btn.addEventListener('touchstart', () => keys[key] = true);
  btn.addEventListener('touchend', () => keys[key] = false);
}
addTouch('btn-up', 'ArrowUp'); addTouch('btn-down', 'ArrowDown');
addTouch('btn-left', 'ArrowLeft'); addTouch('btn-right', 'ArrowRight');

function update() {
  if(gameOver) return;

  // Player movement
  if(keys['ArrowLeft']) player.x -= player.speed;
  if(keys['ArrowRight']) player.x += player.speed;
  if(keys['ArrowUp']) player.y -= player.speed;
  if(keys['ArrowDown']) player.y += player.speed;

  // Keep in bounds + desk collision
  player.x = Math.max(0, Math.min(800 - player.w, player.x));
  player.y = Math.max(0, Math.min(600 - player.h, player.y));
  desks.forEach(d => {
    if(player.x < d.x + d.w && player.x + player.w > d.x && player.y < d.y + d.h && player.y + player.h > d.y) {
      if(keys['ArrowLeft']) player.x += player.speed;
      if(keys['ArrowRight']) player.x -= player.speed;
      if(keys['ArrowUp']) player.y += player.speed;
      if(keys['ArrowDown']) player.y -= player.speed;
    }
  });

  // Boss patrol
  boss.x += boss.speed * boss.dir;
  if(boss.x < 200 || boss.x > 600) boss.dir *= -1;

  // Boss catches you
  if(Math.abs(player.x - boss.x) < 30 && Math.abs(player.y - boss.y) < 30) {
    endGame("CAUGHT BY BOSS! MEETING FOR 2 MORE HOURS!");
  }

  // Collect snacks
  snackItems.forEach(s => {
    if(!s.taken && Math.abs(player.x - s.x) < 20 && Math.abs(player.y - s.y) < 20) {
      s.taken = true;
      snacks++;
      document.getElementById('snacks').innerText = `${snacks}/3`;
    }
  });

  // Boredom goes up
  boredom += 0.05;
  document.getElementById('boredom').innerText = Math.floor(boredom) + '%';
  if(boredom >= 100) endGame("YOU FELL ASLEEP IN THE MEETING!");

  // Win condition
  if(snacks >= 3 && player.x > exit.x && player.y > exit.y) {
    endGame("YOU ESCAPED! WITH SNACKS!");
  }

  draw();
  requestAnimationFrame(update);
}

function draw() {
  ctx.fillStyle = '#e8e8e8';
  ctx.fillRect(0, 0, 800, 600);

  // Desks
  ctx.fillStyle = '#8b4513';
  desks.forEach(d => ctx.fillRect(d.x, d.y, d.w, d.h));

  // Snacks
  ctx.fillStyle = '#ffd700';
  snackItems.forEach(s => { if(!s.taken) ctx.fillRect(s.x, s.y, 15, 15); });

  // Exit Door
  ctx.fillStyle = '#00ff00';
  ctx.fillRect(exit.x, exit.y, exit.w, exit.h);

  // Boss
  ctx.fillStyle = '#ff0000';
  ctx.fillRect(boss.x, boss.y, boss.w, boss.h);

  // Player
  ctx.fillStyle = '#0000ff';
  ctx.fillRect(player.x, player.y, player.w, player.h);
}

function endGame(text) {
  gameOver = true;
  document.getElementById('msg').innerText = text;
  document.getElementById('msg').style.display = 'block';
}

update();
</script>

</body>
</html>
